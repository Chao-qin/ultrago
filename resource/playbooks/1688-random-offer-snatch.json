            "(() => {",
            "  const st = window.__bcp1688 || {};",
            "  const txt = n =>",
            "    String((n && n.textContent) || '')",
            "      .replace(/\\s+/g, ' ')",
            "      .trim();",
            "  // 1688 alicdn 图床后缀归一化:'.jpg_b.jpg' / '.jpg_sum.jpg' / '.jpg_400x400.jpg' 等",
            "  // 都是原图的降采样版本,真正的原图是裸 '.jpg'(800x800)。抖店主图硬约束 ≥600×600,",
            "  // 不归一化就只能抓到 220×220。和 1688-offer-snatch.json 同源逻辑,改动需同步。",
            "  const norm1688 = u => String(u || '').replace(/\\.jpg_[\\w-]+\\.jpg$/, '.jpg');",
            "  const dedupeUrls = arr => {",
            "    const seen = new Set();",
            "    const out = [];",
            "    for (const u of arr) {",
            "      const n = norm1688(u);",
            "      if (n && !seen.has(n)) {",
            "        seen.add(n);",
            "        out.push(n);",
            "      }",
            "    }",
            "    return out;",
            "  };",
            "  const dedupeSkuImages = arr => {",
            "    const seen = new Set();",
            "    const out = [];",
            "    for (const s of arr) {",
            "      const u = norm1688(s.imageUrl || '');",
            "      if (u && !seen.has(u)) {",
            "        seen.add(u);",
            "        out.push({ ...s, imageUrl: u });",
            "      }",
            "    }",
            "    return out;",
            "  };",
            "  const attributes = [",
            "    ...document.querySelectorAll('[data-module=\"od_product_attributes\"] tr')",
            "  ].flatMap(row => {",
            "    const ths = [...row.querySelectorAll('th')],",
            "      tds = [...row.querySelectorAll('td')];",
            "    return ths",
            "      .map((th, i) => {",
            "        const L = txt(th),",
            "          V = txt(tds[i]);",
            "        return L && V ? { Label: L, Value: V } : null;",
            "      })",
            "      .filter(Boolean);",
            "  });",
            "  const m = location.pathname.match(/\\/offer\\/(\\d+)/);",
            "  const skus = Object.values(st.skuMap || {});",
            "  const mainImages = dedupeUrls(Object.keys(st.gallery || {}));",
            "  const detailImages = dedupeUrls(Object.keys(st.detail || {}));",
            "  const skuImages = dedupeSkuImages(Object.values(st.skuImages || {}));",
            "  return {",
            "    title: txt(document.querySelector('[data-module=\"od_title\"] h1')),",
            "    offerId: m ? m[1] : '',",
            "    sourceUrl: location.href,",
            "    capturedBy: 'playbook:1688-random-offer-snatch',",
            "    pageState: /验证码|滑块|风控|访问受限/.test(txt(document.body)) ? 'blocked' : 'product',",
            "    skuDimensions: st.dims || [],",
            "    skus,",
            "    skuImages,",
            "    mainImages,",
            "    detailImages,",
            "    detailProfile: st.profile || '',",
            "    attributes,",
            "    captureMeta: {",
            "      skuCount: skus.length,",
            "      skuWithPrice: skus.filter(s => s.Price != null).length,",
            "      skuWithStock: skus.filter(s => s.Quantity != null).length,",
            "      mainImageCount: mainImages.length,",
            "      detailImageCount: detailImages.length,",
            "      skuImageCount: skuImages.length,",
            "      attributeCount: attributes.length",
            "    }",
            "  };",
            "})()"
          ]
        }
      },
      "page": "source1688",
      "gate": {
        "all": [
          "pageHydrated"
        ]
      }
    },
    {
      "goal": "将 evidence 原样序列化为 JSON 文本",
      "verify": {
        "actionSucceeded": true
      },
      "onFail": "retry",
      "action": {
        "method": "local.eval",
        "params": {
          "code": [
            "// Pick this run's evidence out of `results` by SHAPE, not by index — the step",
            "// layout can shift and an index-based pick would silently serialize another",
            "// step's value. Browser eval results arrive wrapped as {value, truncated}.",
            "const unwrap = entry => {",
            "  const v = entry && entry.value;",
            "  return v && typeof v === 'object' && 'value' in v ? v.value : v;",
            "};",
            "const evidence = [...results]",
            "  .reverse()",
            "  .map(unwrap)",
            "  .find(",
            "    v =>",
            "      v &&",
            "      typeof v === 'object' &&",
            "      typeof v.offerId === 'string' &&",
            "      v.offerId &&",
            "      typeof v.title === 'string' &&",
            "      Array.isArray(v.mainImages) &&",
            "      Array.isArray(v.skus) &&",
            "      v.captureMeta &&",
            "      typeof v.captureMeta === 'object'",
            "  );",
            "if (!evidence) throw new Error(\"no 1688 evidence found in this run's results\");",
            "return JSON.stringify(evidence, null, 2);"
          ]
        }
      },
      "page": "source1688",
      "gate": {
        "all": [
          "pageHydrated"
        ]
      }
    },
    {
      "goal": "写入本地目录 reports/{{outFile}}",
      "verify": {
        "actionSucceeded": true
      },
      "onFail": "retry",
      "action": {
        "method": "local.writeFile",
        "params": {
          "path": "{{outFile}}"
        }
      },
      "page": "source1688",
      "gate": {
        "all": [
          "pageHydrated"
        ]
      }
    },
    {
      "goal": "关闭本次抓取用的 tab(窗口随最后一个 tab 一同关闭),不留孤儿窗口",
      "verify": {
        "actionSucceeded": true
      },
      "onFail": "escalate",
      "action": {
        "method": "browser.closeTab",
        "params": {}
      },
      "page": "source1688",
      "gate": {
        "all": [
          "pageHydrated"
        ]
      }
    }
  ],
  "deliveries": [
    {
      "kind": "file",
      "artifact": "{{outFile}}"
    }
  ],
