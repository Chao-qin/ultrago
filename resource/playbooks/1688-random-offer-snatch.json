            "  }",
            "  for (const c of combo) {",
            "    st.done[c.idx + '|' + c.value] = 1;",
            "    if (/^https?:\\/\\//.test(c.img))",
            "      st.skuImages[c.name + '|' + c.value] = {",
            "        propertyName: c.name,",
            "        valueName: c.value,",
            "        imageUrl: c.img",
            "      };",
            "  }",
            "  for (let i = 0; i < leads.length; i++) {",
            "    const btns = [...leads[i].querySelectorAll('.sku-filter-button')];",
            "    const nx = btns.find(b => !st.done[i + '|' + txt(b.querySelector('.label-name'))]);",
            "    if (nx) {",
