{
  "name": "1688-random-offer-snatch",
  "goal": "1688 随机商品抓取(纯 book · 尽力采集版):刷新首页 → 随机类目 → 随机商品 → 条件门采集多维度 SKU/主图/详情图 → 组装 evidence → 落本地目录",
  "paramSchemaRef": "book-input-1688-random-offer-snatch@1",
  "params": [
    {
      "name": "outFile",
      "required": true,
      "description": "产出 markdown 报告的文件路径（相对 reports/）",
      "schema": {
        "type": "string",
        "minLength": 1
      }
    }
  ],
  "steps": [
    {
      "goal": "在自己独立的新窗口打开1688首页(不抢用户焦点、不碰用户当前标签页;之前版本直接 navigate 当前活跃 tab,用户切个标签页就会被这个 book 顶飞——2026-08-21 实测复现过一次)。开完后续步骤会自动绑定这个 tab,不用每步都传 tabId。注意:本步只确认窗口已开在 1688,**不断言页面已水合** —— newWindow 73ms 就返回(只建 tab 不等加载完),而 page_state.loading 要求 readyState==='complete',settleDom 却只等到 DOMContentLoaded 且封顶 3s;1688 首页图多,冷加载 complete 晚于 3s,再加本步 onFail=escalate 是全 book 唯一 0 重试的步骤,就成了固定踩中的时序竞争(2026-08-30 实测)。就绪判定交给 step 2 的 homeReady gate(30s)+3 次重试,那里才有预算。",
      "verify": {
        "urlIncludes": "1688.com"
      },
      "onFail": "escalate",
      "action": {
        "method": "browser.newWindow",
        "params": {
          "url": "https://www.1688.com/",
          "focused": false,
          "minimized": false,
          "restoreFocus": true
        }
      },
      "page": "source1688"
    },
    {
      "goal": "刷新首页,拿到新一轮推荐",
      "verify": {
        "urlIncludes": "1688.com",
        "noErrors": true,
        "settled": true
      },
      "onFail": "retry",
      "maxRetries": 3,
      "action": {
        "method": "browser.reload",
        "params": {}
      },
      "page": "source1688",
      "gate": {
        "all": [
          "homeReady"
        ]
      }
    },
    {
      "goal": "随机选一个类目搜索入口并跳转。本步对自己的副作用【幂等】：已经在搜索页就直接放行 —— 动作会把页面从首页带走，而门若只认首页，重试就永远进不来（实测：一次 verify 没等到 settled，就被放大成 gate homeReady 永久超时）。门同时认首页与搜索页，动作开头短路，两处缺一不可。",
      "verify": {
        "urlIncludes": "s.1688.com/selloffer",
        "noErrors": true,
        "settled": true
      },
      "onFail": "retry",
      "maxRetries": 3,
      "action": {
        "method": "browser.eval",
        "params": {
          "code": [
            "(async () => {",
            "  /* 幂等短路：本步的动作会把页面从首页带走，重试时已经不在首页了。",
            "     没有这一句，重试会在搜索页上找首页的类目链接，必然找不到。 */",
            "  if (location.href.includes('s.1688.com/selloffer'))",
            "    return { ok: true, note: '已在搜索页，本步无需再跳' };",
            "  /* 等首页把类目入口渲染出来。上限 8000ms / 间隔 200ms 与手写轮询一致，",
            "     区别是 bcpWait 还会压在 bcpDeadline 之下，预算见底即返回而不空转。 */",
            "  const links =",
            "    (await bcpWait.until(() => {",
            "      const found = [",
            "        ...new Set(",
            "          Array.from(document.querySelectorAll('a[href*=\"s.1688.com/selloffer/offer_search.htm\"]'))",
            "            .map(a => a.href)",
            "            .filter(h => h.includes('charset=utf8'))",
            "        )",
            "      ];",
            "      return found.length ? found : null;",
            "    }, 8000, 200)) || [];",
            "  if (!links.length) return { ok: false, reason: 'no category search links on homepage' };",
            "  const picked = links[Math.floor(Math.random() * links.length)];",
            "  location.href = picked;",
            "  return { ok: true, picked, candidates: links.length };",
            "})()"
          ]
        }
      },
      "page": "source1688",
      "gate": {
        "any": [
          "homeReady",
          "searchResultReady"
        ]
      }
    },
    {
      "goal": "随机选一个商品 offerId 并跳转详情页。与 step 3 同构：本步对自己的副作用幂等，门同时认搜索页与详情页，动作开头短路，避免一次偶发的 verify 失败被门放大成永久失败。",
      "verify": {
        "urlIncludes": "detail.1688.com/offer",
        "noErrors": true,
        "settled": true
      },
      "onFail": "retry",
      "maxRetries": 3,
      "action": {
        "method": "browser.eval",
        "params": {
          "code": [
            "(async () => {",
            "  /* 幂等短路：同 step 3 —— 动作会离开搜索页，重试时得认得出「已经到了」。 */",
            "  if (location.href.includes('detail.1688.com/offer'))",
            "    return { ok: true, note: '已在商品详情页，本步无需再跳' };",
            "  /* 等搜索结果渲染出带 offerId 的链接。上限 10000ms / 间隔 250ms 同手写轮询。 */",
            "  const ids =",
            "    (await bcpWait.until(() => {",
            "      const set = new Set();",
            "      for (const a of document.querySelectorAll('a[href]')) {",
            "        const m = a.href.match(/[?&]offerId=(\\d+)/);",
            "        if (m) set.add(m[1]);",
            "      }",
            "      return set.size ? [...set] : null;",
            "    }, 10000, 250)) || [];",
            "  if (!ids.length) return { ok: false, reason: 'no offerId links on search result page' };",
            "  const offerId = ids[Math.floor(Math.random() * ids.length)];",
            "  const url = 'https://detail.1688.com/offer/' + offerId + '.html';",
            "  location.href = url;",
            "  return { ok: true, offerId, url, candidates: ids.length };",
            "})()"
          ]
        }
      },
      "page": "source1688",
      "gate": {
        "any": [
          "searchResultReady",
          "pageHydrated"
        ]
      }
    },
    {
      "goal": "把商品属性注入到 [data-module=\"od_product_attributes\"] 表格(覆盖顶部 cpv-decision-attr 区 + 底部 offer-attr-item 区)。1688 把同一商品属性拆成两个区:商品详情图上方的\"产品特点\"(.cpv-decision-attr .cpv-attr-item) 和下方详情参数(.offer-attr-item)。不合并就漏掉\"面料名称\"这类 SKU 必填属性,导致 LLM 拿不到 source → 写 attribute_property_ids_unmapped pending。和 1688-offer-snatch.json 同源逻辑,改动需同步。",
      "verify": {
        "noErrors": true
      },
      "onFail": "retry",
      "maxRetries": 2,
      "action": {
        "method": "browser.eval",
        "params": {
          "code": [
            "(() => {",
            "  const norm = n =>",
            "    String((n && n.textContent) || '')",
            "      .replace(/\\s+/g, ' ')",
            "      .trim();",
            "  let tbl = document.querySelector('[data-module=\"od_product_attributes\"] table');",
            "  if (!tbl) {",
            "    const root = document.createElement('div');",
            "    root.dataset.module = 'od_product_attributes';",
            "    tbl = document.createElement('table');",
            "    root.appendChild(tbl);",
            "    document.body.appendChild(root);",
            "  }",
            "  for (const it of document.querySelectorAll('.offer-attr-item')) {",
            "    const L = norm(it.querySelector('.offer-attr-item-name')),",
            "      V = norm(it.querySelector('.offer-attr-item-value'));",
            "    if (!L) continue;",
            "    const tr = document.createElement('tr'),",
            "      th = document.createElement('th'),",
            "      td = document.createElement('td');",
            "    th.textContent = L;",
            "    td.textContent = V;",
            "    tr.append(th, td);",
            "    tbl.append(tr);",
            "  }",
            "  for (const it of document.querySelectorAll('.cpv-decision-attr .cpv-attr-item')) {",
            "    const L = norm(it.querySelector('.cpv-attr-label')),",
            "      V = norm(it.querySelector('.cpv-attr-value'));",
            "    if (!L) continue;",
            "    const tr = document.createElement('tr'),",
            "      th = document.createElement('th'),",
            "      td = document.createElement('td');",
            "    th.textContent = L;",
            "    td.textContent = V;",
            "    tr.append(th, td);",
            "    tbl.append(tr);",
            "  }",
            "  return tbl.querySelectorAll('tr').length > 0;",
            "})()"
          ]
        }
      },
      "page": "source1688",
      "gate": {
        "all": [
          "pageHydrated"
        ]
      }
    },
