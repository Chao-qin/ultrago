# Browser Control Protocol configuration
BCP_PORT=8787
BCP_MCP_PORT=8788
BCP_TOKEN=replace-with-a-local-token
BCP_RPC_TIMEOUT_MS=30000
BCP_KEEP_FAILED_TABS=1
BCP_ALLOWED_DOMAINS=
BCP_BLOCKED_DOMAINS=
BCP_EVAL=on
BCP_LOCAL_EVAL=on

# Console
CONSOLE_PORT=8790
DATABASE_URL=file:../../../resource/db/console.db
BCP_HOST=127.0.0.1

# Optional image bed integration
IMAGE_BED_TOKEN=replace-with-a-token
IMAGE_BED_OWNER=replace-with-owner
IMAGE_BED_REPO=replace-with-repository
IMAGE_BED_BRANCH=main
IMAGE_BED_PATH_PREFIX=images
IMAGE_BED_CUSTOM_DOMAIN=

# LLM gateway
BCP_LLM_ENABLE=0
BCP_LLM_PORT=11435
BCP_LLM_OLLAMA_PORT=11437
BCP_LLM_OPENCODE_PORT=11438
BCP_LLM_MODEL=qwen3.5:4b
BCP_LLM_NUM_CTX=32768
BCP_LLM_KEEP_ALIVE=-1
BCP_LLM_PROVIDER=ollama
BCP_LLM_LMSTUDIO_MODEL_KEY=
BCP_LLM_LMSTUDIO_MODEL_ID=
BCP_LLM_LMSTUDIO_RUNTIME_KEY=
BCP_LLM_LMSTUDIO_MODEL_FORMAT=gguf
BCP_LLM_LMSTUDIO_PORT=11436
BCP_LLM_LMSTUDIO_CONTEXT_LENGTH=32768
BCP_LLM_LMSTUDIO_GPU=max
BCP_LLM_LMSTUDIO_BIND=127.0.0.1
BCP_LLM_LMSTUDIO_BIN=

# Optional cloud channels and webhooks
AIHUB_API_KEY=replace-with-a-key
BCP_EVENT_WEBHOOK=
VULCAN_API_KEY=replace-with-a-key
