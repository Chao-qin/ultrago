{
  "name": "@bcp/extension",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @bcp/shared build && wxt",
    "dev:firefox": "pnpm --filter @bcp/shared build && wxt -b firefox",
    "build": "pnpm --filter @bcp/shared build && wxt build",
    "build:firefox": "pnpm --filter @bcp/shared build && wxt build -b firefox",
    "zip": "pnpm --filter @bcp/shared build && wxt zip",
    "zip:firefox": "pnpm --filter @bcp/shared build && wxt zip -b firefox",
    "typecheck": "pnpm --filter @bcp/shared build && wxt prepare && tsc --noEmit",
    "check:dom": "node scripts/dom-runtime-check.mjs",
    "postinstall": "wxt prepare",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@bcp/shared": "workspace:*",
    "lucide-react": "^1.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vite": "^6.3.4",
    "wxt": "^0.21.3"
  }
}
