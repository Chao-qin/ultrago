{
  "name": "@bcp/console",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "RPA 管理后台 — nestjs + prisma + sqlite 调度与观测 ultrago playbook",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run prisma:generate && pnpm run build:server",
    "build:web": "pnpm --dir web run build",
    "build:server": "tsc -p tsconfig.json",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "dev": "concurrently -k -n web,api -c blue,green \"pnpm run dev:web\" \"pnpm run dev:api\"",
    "dev:web": "pnpm --dir web run dev",
    "dev:api": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/runs/*.test.ts src/schedules/*.test.ts src/scheduler/*.test.ts src/prisma/*.test.ts src/uploads/*.test.ts src/image-bed/*.test.ts src/schemas/*.test.ts src/schema-records/*.test.ts src/flows/*.test.ts src/scripts/*.test.ts src/records/*.test.ts src/filesync/*.test.ts src/books/*.test.ts src/settings/*.test.ts src/browser-events/*.test.ts src/llm-calls/*.test.ts src/internal-routes.test.ts web/src/lib/*.test.ts",
    "test:ui": "node --test ../../scripts/test-flow-diagnostics-ui.mjs"
  },
  "dependencies": {
    "@bcp/shared": "workspace:*",
    "@bcp/weclaw": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@prisma/client": "^5.20.0",
    "@prisma/studio-core": "^0.33.0",
    "cron-parser": "^4.9.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "eventsource-parser": "^1.1.2",
    "express": "^4.21.0",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-fetch": "^2.6.11",
    "concurrently": "^9.0.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
