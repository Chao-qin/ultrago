# 远端生图服务（OpenAI 兼容）。复制为 .env 填写；修改后需重启 ComfyUI。
OPENAI_API_BASE=https://your-base-url/v1
OPENAI_API_KEY=your_key_here

# 文本模型（OpenAI 兼容 chat.completions），给「AI 选技能」「公众号文章」节点用；可以和上面不是同一个渠道。
# 改完立即生效，不用重启。
TEXT_API_BASE=https://your-text-base-url/v1
TEXT_API_KEY=your_text_key_here
TEXT_MODEL=your-model-name
